{
  "name": "saver",
  "private": true,
  "version": "1.0.0",
  "description": "Saver: a local-first personal finance and budgeting app with optional NZ bank sync via Akahu",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "npm run build --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "test:server": "npm run test --workspace=server",
    "lint": "npm run lint --workspace=client",
    "smoke": "npm run smoke --workspace=client"
  }
}
