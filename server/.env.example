# Optional server settings. Copy this file to `.env` (in this folder) to use it.
# Everything here has a sensible default, so most people never need this file.

# Akahu bank sync. The easiest way is to paste your tokens on the Accounts page
# in the app instead. Values set here take priority over tokens saved in the app.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=

# Port the app runs on (http://localhost:4000 by default).
PORT=4000

# Where your data lives. Defaults to server/data/budget.sqlite.
# BUDGET_DB_PATH=

# Extra keyword rules for your own local businesses. Defaults to server/data/custom-rules.json.
# CUSTOM_RULES_PATH=
